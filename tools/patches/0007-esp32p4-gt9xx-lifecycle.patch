+/****************************************************************************
+ * Name: gt9xx_select_address
+ *
+ * Description:
+ *   Power the controller and, when RESET and INT are wired, perform the
+ *   address-selection sequence documented by Goodix.  Boards with neither
+ *   signal connected retain the power-up-and-probe fallback.
+ *
+ ****************************************************************************/
+
+static int gt9xx_select_address(FAR struct gt9xx_dev_s *dev, uint8_t addr)
+{
+  bool irq_high = addr == 0x14;
+  int ret;
+
+  if ((dev->board->set_reset == NULL) !=
+      (dev->board->set_irq_mode == NULL))
+    {
+      ierr("RESET and INT mode callbacks must be provided together\n");
+      return -EINVAL;
+    }
+
+  ret = dev->board->set_power(dev->board, true);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  dev->addr = addr;
+  if (dev->board->set_reset == NULL)
+    {
+      nxsig_usleep(100 * 1000);
+      return OK;
+    }
+
+  ret = dev->board->set_reset(dev->board, true);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = dev->board->set_irq_mode(dev->board, true, irq_high);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  nxsig_usleep(100);
+  ret = dev->board->set_reset(dev->board, false);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  nxsig_usleep(5 * 1000);
+  ret = dev->board->set_irq_mode(dev->board, false, false);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  nxsig_usleep(50 * 1000);
+  return OK;
+}
+
+static int gt9xx_select_and_probe(FAR struct gt9xx_dev_s *dev,
+                                  uint8_t addr)
+{
+  int tries;
+  int ret;
+
+  ret = gt9xx_select_address(dev, addr);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  for (tries = 0; tries < 3; tries++)
+    {
+      ret = gt9xx_probe_device(dev);
+      if (ret == OK)
+        {
+          return OK;
+        }
+
+      nxsig_usleep(50 * 1000);
+    }
+
+  return ret;
+}
