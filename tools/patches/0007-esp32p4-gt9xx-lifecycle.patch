+#if CONFIG_INPUT_GT9XX_POLL_INTERVAL > 0
+/****************************************************************************
+ * Name: gt9xx_poll_worker
+ *
+ * Description:
+ *   Wake poll waiters on boards without a connected touch interrupt.  I2C
+ *   access remains in gt9xx_read(), so the low-priority worker never blocks
+ *   on the bus and can be cancelled synchronously on last close.
+ *
+ ****************************************************************************/
+
+static void gt9xx_poll_worker(FAR void *arg)
+{
+  FAR struct gt9xx_dev_s *priv = arg;
+  irqstate_t flags;
+  bool polling;
+  int ret;
+
+  flags = enter_critical_section();
+  polling = priv->polling;
+  if (polling)
+    {
+      priv->int_pending = true;
+    }
+
+  leave_critical_section(flags);
+
+  if (!polling)
+    {
+      return;
+    }
+
+  poll_notify(priv->fds, CONFIG_INPUT_GT9XX_NPOLLWAITERS, POLLIN);
+  ret = work_queue(LPWORK, &priv->work, gt9xx_poll_worker, priv,
+                   MSEC2TICK(CONFIG_INPUT_GT9XX_POLL_INTERVAL));
+  if (ret < 0)
+    {
+      flags = enter_critical_section();
+      priv->polling = false;
+      leave_critical_section(flags);
+      ierr("Failed to requeue poll worker: %d\n", ret);
+    }
+}
+#endif
