+/****************************************************************************
+ * Name: esp_mipi_dsi_swap_framebuffer
+ *
+ * Description:
+ *   Queue one framebuffer for the next completed-frame boundary and wait
+ *   until DW-GDMA has switched away from the previous framebuffer.
+ *
+ ****************************************************************************/
+
+int esp_mipi_dsi_swap_framebuffer(FAR void *fb, uint32_t timeout_ms)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv = &g_esp_mipi_dsi;
+  irqstate_t flags;
+  int ret;
+
+  if (fb == NULL || timeout_ms == 0)
+    {
+      return -EINVAL;
+    }
+
+  nxsem_reset(&priv->fb_done, 0);
+  flags = spin_lock_irqsave(&priv->dmalock);
+  if (!priv->fb_bound || !priv->dma_enabled)
+    {
+      spin_unlock_irqrestore(&priv->dmalock, flags);
+      return -EAGAIN;
+    }
+
+  if (priv->fb_callback != NULL || priv->pending_fb != NULL)
+    {
+      spin_unlock_irqrestore(&priv->dmalock, flags);
+      return -EBUSY;
+    }
+
+  priv->pending_fb = fb;
+  spin_unlock_irqrestore(&priv->dmalock, flags);
+
+  ret = nxsem_tickwait_uninterruptible(&priv->fb_done,
+                                       MSEC2TICK(timeout_ms));
+  if (ret < 0)
+    {
+      flags = spin_lock_irqsave(&priv->dmalock);
+      if (priv->pending_fb == fb)
+        {
+          priv->pending_fb = NULL;
+        }
+
+      spin_unlock_irqrestore(&priv->dmalock, flags);
+    }
+
+  return ret;
+}
 
