diff --git a/arch/risc-v/src/common/espressif/esp_mipi_csi.c b/arch/risc-v/src/common/espressif/esp_mipi_csi.c
new file mode 100644
index 00000000..22322036
--- /dev/null
+++ b/arch/risc-v/src/common/espressif/esp_mipi_csi.c
@@ -0,0 +1,589 @@
+/****************************************************************************
+ * arch/risc-v/src/common/espressif/esp_mipi_csi.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/param.h>
+#include <syslog.h>
+#include <sys/time.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/cache.h>
+#include <nuttx/debug.h>
+#include <nuttx/irq.h>
+#include <nuttx/kmalloc.h>
+#include <nuttx/spinlock.h>
+#include <nuttx/video/imgdata.h>
+
+#include "esp_mipi_csi.h"
+#include "esp_attr.h"
+#include "esp_private/esp_clk_tree_common.h"
+#include "esp_irq.h"
+#include "esp_private/periph_ctrl.h"
+#include "hal/dw_gdma_hal.h"
+#include "hal/dw_gdma_ll.h"
+#include "hal/hal_utils.h"
+#include "hal/isp_ll.h"
+#include "hal/isp_types.h"
+#include "hal/mipi_csi_hal.h"
+#include "hal/mipi_csi_ll.h"
+#include "soc/clk_tree_defs.h"
+#include "soc/mipi_csi_bridge_reg.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define ESP_MIPI_CSI_WIDTH       1024
+#define ESP_MIPI_CSI_HEIGHT      600
+#define ESP_MIPI_CSI_BPP         8
+#define ESP_MIPI_CSI_LANES       2
+#define ESP_MIPI_CSI_LANE_MBPS   288
+#define ESP_MIPI_CSI_DMA_CHAN    1
+#define ESP_MIPI_CSI_DMA_ALIGN   64
+#define ESP_MIPI_CSI_FRAME_SIZE  \
+  (ESP_MIPI_CSI_WIDTH * ESP_MIPI_CSI_HEIGHT)
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct esp_mipi_csi_s
+{
+  struct imgdata_s data;
+  mipi_csi_hal_context_t hal;
+  FAR dw_gdma_dev_t *dma;
+  FAR isp_dev_t *isp;
+  spinlock_t lock;
+  FAR uint8_t *fb;
+  uint32_t fb_size;
+  imgdata_capture_t callback;
+  FAR void *callback_arg;
+  bool initialized;
+  bool capturing;
+};
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static int esp_mipi_csi_init(FAR struct imgdata_s *data);
+static int esp_mipi_csi_uninit(FAR struct imgdata_s *data);
+static int esp_mipi_csi_set_buf(FAR struct imgdata_s *data,
+                                uint8_t nr_datafmts,
+                                FAR imgdata_format_t *datafmts,
+                                FAR uint8_t *addr, uint32_t size);
+static int esp_mipi_csi_validate(FAR struct imgdata_s *data,
+                                 uint8_t nr_datafmts,
+                                 FAR imgdata_format_t *datafmts,
+                                 FAR imgdata_interval_t *interval);
+static int esp_mipi_csi_start(FAR struct imgdata_s *data,
+                              uint8_t nr_datafmts,
+                              FAR imgdata_format_t *datafmts,
+                              FAR imgdata_interval_t *interval,
+                              imgdata_capture_t callback, FAR void *arg);
+static int esp_mipi_csi_stop(FAR struct imgdata_s *data);
+static FAR void *esp_mipi_csi_alloc(FAR struct imgdata_s *data,
+                                    uint32_t align_size, uint32_t size);
+static void esp_mipi_csi_free(FAR struct imgdata_s *data, FAR void *addr);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const struct imgdata_ops_s g_esp_mipi_csi_ops =
+{
+  .init = esp_mipi_csi_init,
+  .uninit = esp_mipi_csi_uninit,
+  .set_buf = esp_mipi_csi_set_buf,
+  .validate_frame_setting = esp_mipi_csi_validate,
+  .start_capture = esp_mipi_csi_start,
+  .stop_capture = esp_mipi_csi_stop,
+  .alloc = esp_mipi_csi_alloc,
+  .free = esp_mipi_csi_free,
+};
+
+static struct esp_mipi_csi_s g_esp_mipi_csi =
+{
+  .data =
+  {
+    .ops = &g_esp_mipi_csi_ops
+  },
+  .lock = SP_UNLOCKED,
+};
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+#ifndef CONFIG_ESPRESSIF_MIPI_DSI
+static int IRAM_ATTR esp_mipi_csi_dma_irq(int irq, FAR void *context,
+                                          FAR void *arg)
+{
+  UNUSED(irq);
+  UNUSED(context);
+  UNUSED(arg);
+  return esp_mipi_csi_dma_isr();
+}
+#endif
+
+static int esp_mipi_csi_isp_bypass_init(FAR struct esp_mipi_csi_s *priv)
+{
+  hal_utils_clk_div_t clk_div;
+  esp_err_t err;
+
+  priv->isp = ISP_LL_GET_HW(0);
+  memset(&clk_div, 0, sizeof(clk_div));
+  clk_div.integer = 2;
+
+  err = esp_clk_tree_enable_src((soc_module_clk_t)ISP_CLK_SRC_DEFAULT,
+                                true);
+  if (err != ESP_OK)
+    {
+      verr("CSI: enable ISP clock source failed: %d\n", (int)err);
+      priv->isp = NULL;
+      return -EIO;
+    }
+
+  PERIPH_RCC_ATOMIC()
+    {
+      isp_ll_enable_module_clock(priv->isp, true);
+      isp_ll_reset_module_clock(priv->isp);
+      isp_ll_select_clk_source(priv->isp, ISP_CLK_SRC_DEFAULT);
+      isp_ll_set_clock_div(priv->isp, &clk_div);
+    }
+
+  isp_ll_init(priv->isp);
+  isp_ll_clk_enable(priv->isp, true);
+  isp_ll_set_input_data_source(priv->isp, ISP_INPUT_DATA_SOURCE_CSI);
+  isp_ll_enable_line_start_packet_exist(priv->isp, false);
+  isp_ll_enable_line_end_packet_exist(priv->isp, false);
+  isp_ll_set_intput_data_h_pixel_num(priv->isp,
+                                     ESP_MIPI_CSI_FRAME_SIZE /
+                                     ESP_MIPI_CSI_HEIGHT / 4);
+  isp_ll_set_intput_data_v_row_num(priv->isp, ESP_MIPI_CSI_HEIGHT);
+  isp_ll_shadow_set_mode(priv->isp,
+                         ISP_SHADOW_MODE_UPDATE_ONLY_NEXT_VSYNC);
+  isp_ll_enable(priv->isp, false);
+  return OK;
+}
+
+static void esp_mipi_csi_dma_config(FAR struct esp_mipi_csi_s *priv)
+{
+  FAR dw_gdma_dev_t *dma = priv->dma;
+  uint32_t block_items = ESP_MIPI_CSI_FRAME_SIZE / 8;
+
+  dw_gdma_ll_channel_enable(dma, ESP_MIPI_CSI_DMA_CHAN, false);
+  dw_gdma_ll_channel_set_src_addr(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                  MIPI_CSI_BRG_MEM_BASE);
+  dw_gdma_ll_channel_set_dst_addr(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                  (uint32_t)(uintptr_t)priv->fb);
+  dw_gdma_ll_channel_set_trans_block_size(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                          block_items);
+  dw_gdma_ll_channel_set_src_master_port(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         MIPI_CSI_BRG_MEM_BASE);
+  dw_gdma_ll_channel_set_dst_master_port(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         (intptr_t)priv->fb);
+  dw_gdma_ll_channel_set_src_trans_width(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         DW_GDMA_TRANS_WIDTH_64);
+  dw_gdma_ll_channel_set_dst_trans_width(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         DW_GDMA_TRANS_WIDTH_64);
+  dw_gdma_ll_channel_set_src_burst_items(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         DW_GDMA_BURST_ITEMS_512);
+  dw_gdma_ll_channel_set_dst_burst_items(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                         DW_GDMA_BURST_ITEMS_512);
+  dw_gdma_ll_channel_set_src_burst_mode(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                        DW_GDMA_BURST_MODE_FIXED);
+  dw_gdma_ll_channel_set_dst_burst_mode(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                        DW_GDMA_BURST_MODE_INCREMENT);
+  dw_gdma_ll_channel_set_src_burst_len(dma, ESP_MIPI_CSI_DMA_CHAN, 16);
+  dw_gdma_ll_channel_set_dst_burst_len(dma, ESP_MIPI_CSI_DMA_CHAN, 16);
+  dw_gdma_ll_channel_set_block_markers(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                       true, true, true);
+}
+
+static int esp_mipi_csi_dma_setup(FAR struct esp_mipi_csi_s *priv)
+{
+  FAR dw_gdma_dev_t *dma = DW_GDMA_LL_GET_HW(0);
+  int ret;
+
+  PERIPH_RCC_ATOMIC()
+    {
+      dw_gdma_ll_enable_bus_clock(0, true);
+#ifndef CONFIG_ESPRESSIF_MIPI_DSI
+      dw_gdma_ll_reset_register(0);
+#endif
+    }
+
+  priv->dma = dma;
+  dw_gdma_ll_channel_set_trans_flow(dma, ESP_MIPI_CSI_DMA_CHAN,
+                                    DW_GDMA_ROLE_PERIPH_CSI,
+                                    DW_GDMA_ROLE_MEM,
+                                    DW_GDMA_FLOW_CTRL_SRC);
+  dw_gdma_ll_channel_set_src_multi_block_type(
+    dma, ESP_MIPI_CSI_DMA_CHAN, DW_GDMA_BLOCK_TRANSFER_CONTIGUOUS);
+  dw_gdma_ll_channel_set_dst_multi_block_type(
+    dma, ESP_MIPI_CSI_DMA_CHAN, DW_GDMA_BLOCK_TRANSFER_CONTIGUOUS);
+  dw_gdma_ll_channel_set_src_handshake_interface(
+    dma, ESP_MIPI_CSI_DMA_CHAN, DW_GDMA_HANDSHAKE_HW);
+  dw_gdma_ll_channel_set_dst_handshake_interface(
+    dma, ESP_MIPI_CSI_DMA_CHAN, DW_GDMA_HANDSHAKE_HW);
+  dw_gdma_ll_channel_set_src_handshake_periph(
+    dma, ESP_MIPI_CSI_DMA_CHAN, DW_GDMA_ROLE_PERIPH_CSI);
+  /* Yield shared bus bandwidth to the continuous DSI scanout channel. */
+
+  dw_gdma_ll_channel_set_priority(dma, ESP_MIPI_CSI_DMA_CHAN, 0);
+  dw_gdma_ll_channel_set_src_outstanding_limit(
+    dma, ESP_MIPI_CSI_DMA_CHAN, 5);
+  dw_gdma_ll_channel_set_dst_outstanding_limit(
+    dma, ESP_MIPI_CSI_DMA_CHAN, 5);
+  dw_gdma_ll_channel_set_src_periph_status_addr(
+    dma, ESP_MIPI_CSI_DMA_CHAN, MIPI_CSI_BRG_MEM_BASE);
+  dw_gdma_ll_channel_enable_intr_generation(
+    dma, ESP_MIPI_CSI_DMA_CHAN, UINT32_MAX, true);
+  dw_gdma_ll_channel_enable_intr_propagation(
+    dma, ESP_MIPI_CSI_DMA_CHAN,
+    DW_GDMA_LL_CHANNEL_EVENT_DMA_TFR_DONE, true);
+  dw_gdma_ll_channel_clear_intr(dma, ESP_MIPI_CSI_DMA_CHAN, UINT32_MAX);
+
+#ifndef CONFIG_ESPRESSIF_MIPI_DSI
+  ret = esp_setup_irq(DW_GDMA_INTR_SOURCE,
+                      ESP_IRQ_PRIORITY_DEFAULT,
+                      ESP_IRQ_TRIGGER_LEVEL,
+                      esp_mipi_csi_dma_irq, priv);
+  if (ret < 0)
+    {
+      verr("CSI: DW-GDMA IRQ setup failed: %d\n", ret);
+      priv->dma = NULL;
+      return ret;
+    }
+
+  up_enable_irq(ESP_IRQ_DW_GDMA);
+#endif
+
+  return OK;
+}
+
+static int esp_mipi_csi_init(FAR struct imgdata_s *data)
+{
+  FAR struct esp_mipi_csi_s *priv = (FAR struct esp_mipi_csi_s *)data;
+  mipi_csi_hal_config_t config;
+  esp_err_t err;
+
+  if (priv->initialized)
+    {
+      return OK;
+    }
+
+  err = esp_clk_tree_enable_src(
+          (soc_module_clk_t)MIPI_CSI_PHY_CLK_SRC_DEFAULT, true);
+  if (err != ESP_OK)
+    {
+      verr("CSI: enable PHY clock source failed: %d\n", (int)err);
+      return -EIO;
+    }
+
+  PERIPH_RCC_ATOMIC()
+    {
+      mipi_csi_ll_enable_host_bus_clock(0, true);
+      mipi_csi_ll_reset_host_clock(0);
+      mipi_csi_ll_enable_brg_module_clock(0, true);
+      mipi_csi_ll_reset_brg_module_clock(0);
+      mipi_csi_brg_ll_enable_clock(MIPI_CSI_BRG_LL_GET_HW(0), true);
+      mipi_csi_ll_set_phy_clock_source(0,
+                                       MIPI_CSI_PHY_CLK_SRC_DEFAULT);
+      mipi_csi_ll_enable_phy_config_clock(0, false);
+      mipi_csi_ll_enable_phy_config_clock(0, true);
+    }
+
+  memset(&config, 0, sizeof(config));
+  config.lanes_num = ESP_MIPI_CSI_LANES;
+  config.frame_height = ESP_MIPI_CSI_WIDTH;
+  config.frame_width = ESP_MIPI_CSI_HEIGHT;
+  config.in_bpp = ESP_MIPI_CSI_BPP;
+  config.out_bpp = ESP_MIPI_CSI_BPP;
+  config.lane_bit_rate_mbps = ESP_MIPI_CSI_LANE_MBPS;
+  mipi_csi_hal_init(&priv->hal, &config);
+  mipi_csi_brg_ll_set_burst_len(priv->hal.bridge_dev, 512);
+  mipi_csi_brg_ll_enable_color_conversion(priv->hal.bridge_dev, true);
+  mipi_csi_brg_ll_set_color_mode_bypass(priv->hal.bridge_dev, true);
+  if (esp_mipi_csi_isp_bypass_init(priv) < 0)
+    {
+      return -EIO;
+    }
+
+  if (esp_mipi_csi_dma_setup(priv) < 0)
+    {
+      return -EIO;
+    }
+
+  priv->initialized = true;
+  return OK;
+}
+
+static int esp_mipi_csi_uninit(FAR struct imgdata_s *data)
+{
+  FAR struct esp_mipi_csi_s *priv = (FAR struct esp_mipi_csi_s *)data;
+
+  esp_mipi_csi_stop(data);
+  priv->initialized = false;
+  return OK;
+}
+
+static int esp_mipi_csi_set_buf(FAR struct imgdata_s *data,
+                                uint8_t nr_datafmts,
+                                FAR imgdata_format_t *datafmts,
+                                FAR uint8_t *addr, uint32_t size)
+{
+  FAR struct esp_mipi_csi_s *priv = (FAR struct esp_mipi_csi_s *)data;
+
+  if (nr_datafmts != 1 || datafmts == NULL ||
+      datafmts[0].width != ESP_MIPI_CSI_WIDTH ||
+      datafmts[0].height != ESP_MIPI_CSI_HEIGHT ||
+      datafmts[0].pixelformat != IMGDATA_PIX_FMT_SBGGR8 ||
+      addr == NULL || size < ESP_MIPI_CSI_FRAME_SIZE)
+    {
+      return -EINVAL;
+    }
+
+  priv->fb = addr;
+  priv->fb_size = size;
+  esp_mipi_csi_dma_config(priv);
+  return OK;
+}
+
+static int esp_mipi_csi_validate(FAR struct imgdata_s *data,
+                                 uint8_t nr_datafmts,
+                                 FAR imgdata_format_t *datafmts,
+                                 FAR imgdata_interval_t *interval)
+{
+  if (nr_datafmts != 1 || datafmts == NULL ||
+      interval == NULL ||
+      datafmts[0].width != ESP_MIPI_CSI_WIDTH ||
+      datafmts[0].height != ESP_MIPI_CSI_HEIGHT ||
+      datafmts[0].pixelformat != IMGDATA_PIX_FMT_SBGGR8 ||
+      interval->numerator != 1 || interval->denominator != 30)
+    {
+      return -EINVAL;
+    }
+
+  return OK;
+}
+
+static int esp_mipi_csi_start(FAR struct imgdata_s *data,
+                              uint8_t nr_datafmts,
+                              FAR imgdata_format_t *datafmts,
+                              FAR imgdata_interval_t *interval,
+                              imgdata_capture_t callback, FAR void *arg)
+{
+  FAR struct esp_mipi_csi_s *priv = (FAR struct esp_mipi_csi_s *)data;
+  irqstate_t flags;
+
+  if (!priv->initialized || priv->fb == NULL || callback == NULL)
+    {
+      return -EINVAL;
+    }
+
+  flags = spin_lock_irqsave(&priv->lock);
+  if (priv->capturing)
+    {
+      spin_unlock_irqrestore(&priv->lock, flags);
+      return -EBUSY;
+    }
+
+  priv->callback = callback;
+  priv->callback_arg = arg;
+  priv->capturing = true;
+  esp_mipi_csi_dma_config(priv);
+  dw_gdma_ll_channel_clear_intr(priv->dma, ESP_MIPI_CSI_DMA_CHAN,
+                                UINT32_MAX);
+  dw_gdma_ll_channel_enable(priv->dma, ESP_MIPI_CSI_DMA_CHAN, true);
+  mipi_csi_brg_ll_enable(priv->hal.bridge_dev, true);
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return OK;
+}
+
+static int esp_mipi_csi_stop(FAR struct imgdata_s *data)
+{
+  FAR struct esp_mipi_csi_s *priv = (FAR struct esp_mipi_csi_s *)data;
+  irqstate_t flags = spin_lock_irqsave(&priv->lock);
+
+  priv->capturing = false;
+  mipi_csi_brg_ll_enable(priv->hal.bridge_dev, false);
+  if (priv->dma != NULL)
+    {
+      dw_gdma_ll_channel_enable(priv->dma, ESP_MIPI_CSI_DMA_CHAN, false);
+      dw_gdma_ll_channel_clear_intr(priv->dma, ESP_MIPI_CSI_DMA_CHAN,
+                                    UINT32_MAX);
+    }
+
+  priv->callback = NULL;
+  priv->callback_arg = NULL;
+  priv->fb = NULL;
+  priv->fb_size = 0;
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return OK;
+}
+
+static FAR void *esp_mipi_csi_alloc(FAR struct imgdata_s *data,
+                                    uint32_t align_size, uint32_t size)
+{
+  return kumm_memalign(MAX(align_size, ESP_MIPI_CSI_DMA_ALIGN), size);
+}
+
+static void esp_mipi_csi_free(FAR struct imgdata_s *data, FAR void *addr)
+{
+  kumm_free(addr);
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int esp_mipi_csi_dma_isr(void)
+{
+  FAR struct esp_mipi_csi_s *priv = &g_esp_mipi_csi;
+  imgdata_capture_t callback;
+  FAR void *callback_arg;
+  struct timeval ts;
+  irqstate_t flags;
+  uint32_t status;
+
+  if (priv->dma == NULL)
+    {
+      return OK;
+    }
+
+  status = dw_gdma_ll_channel_get_intr_status(priv->dma,
+                                               ESP_MIPI_CSI_DMA_CHAN);
+  if (status == 0)
+    {
+      return OK;
+    }
+
+  dw_gdma_ll_channel_clear_intr(priv->dma, ESP_MIPI_CSI_DMA_CHAN, status);
+  if ((status & DW_GDMA_LL_CHANNEL_EVENT_DMA_TFR_DONE) == 0)
+    {
+      return OK;
+    }
+
+  flags = spin_lock_irqsave(&priv->lock);
+  dw_gdma_ll_channel_enable(priv->dma, ESP_MIPI_CSI_DMA_CHAN, false);
+  mipi_csi_brg_ll_enable(priv->hal.bridge_dev, false);
+  callback = priv->callback;
+  callback_arg = priv->callback_arg;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  if (callback != NULL)
+    {
+      gettimeofday(&ts, NULL);
+      callback(0, ESP_MIPI_CSI_FRAME_SIZE, &ts, callback_arg);
+    }
+
+  flags = spin_lock_irqsave(&priv->lock);
+  if (priv->capturing && priv->fb != NULL)
+    {
+      esp_mipi_csi_dma_config(priv);
+      dw_gdma_ll_channel_enable(priv->dma, ESP_MIPI_CSI_DMA_CHAN, true);
+      mipi_csi_brg_ll_enable(priv->hal.bridge_dev, true);
+    }
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return OK;
+}
+
+FAR struct imgdata_s *esp_mipi_csi_initialize(void)
+{
+  return &g_esp_mipi_csi.data;
+}
+
+void esp_mipi_csi_dump_status(void)
+{
+  FAR struct esp_mipi_csi_s *priv = &g_esp_mipi_csi;
+  uint32_t clock_hs_samples = 0;
+  uint32_t all_stop_samples = 0;
+  int i;
+
+  if (priv->dma == NULL)
+    {
+      syslog(LOG_INFO, "CSI: DMA is not initialized\n");
+      return;
+    }
+
+  syslog(LOG_INFO,
+         "CSI: intr=0x%08lx amount=%lu fifo=%lu src=0x%08lx "
+         "fb=%p active=%u\n",
+         (unsigned long)dw_gdma_ll_channel_get_intr_status(
+           priv->dma, ESP_MIPI_CSI_DMA_CHAN),
+         (unsigned long)dw_gdma_ll_channel_get_trans_amount(
+           priv->dma, ESP_MIPI_CSI_DMA_CHAN),
+         (unsigned long)dw_gdma_ll_channel_get_fifo_remain(
+           priv->dma, ESP_MIPI_CSI_DMA_CHAN),
+         (unsigned long)dw_gdma_ll_channel_get_src_periph_status(
+           priv->dma, ESP_MIPI_CSI_DMA_CHAN),
+         priv->fb, priv->capturing);
+  syslog(LOG_INFO,
+         "CSI: host ver=0x%08lx lanes=0x%08lx reset=0x%08lx "
+         "shutdown=0x%08lx dphy_reset=0x%08lx\n",
+         (unsigned long)priv->hal.host_dev->version.val,
+         (unsigned long)priv->hal.host_dev->n_lanes.val,
+         (unsigned long)priv->hal.host_dev->csi2_resetn.val,
+         (unsigned long)priv->hal.host_dev->phy_shutdownz.val,
+         (unsigned long)priv->hal.host_dev->dphy_rstz.val);
+  syslog(LOG_INFO,
+         "CSI: phy_rx=0x%08lx stop=0x%08lx main=0x%08lx "
+         "phy_fatal=0x%08lx pkt_fatal=0x%08lx phy=0x%08lx\n",
+         (unsigned long)priv->hal.host_dev->phy_rx.val,
+         (unsigned long)priv->hal.host_dev->phy_stopstate.val,
+         (unsigned long)priv->hal.host_dev->int_st_main.val,
+         (unsigned long)priv->hal.host_dev->int_st_phy_fatal.val,
+         (unsigned long)priv->hal.host_dev->int_st_pkt_fatal.val,
+         (unsigned long)priv->hal.host_dev->int_st_phy.val);
+  syslog(LOG_INFO,
+         "CSI: bridge clk=0x%08lx en=0x%08lx frame=0x%08lx "
+         "dtype=0x%08lx int=0x%08lx\n",
+         (unsigned long)priv->hal.bridge_dev->host_ctrl.val,
+         (unsigned long)priv->hal.bridge_dev->csi_en.val,
+         (unsigned long)priv->hal.bridge_dev->frame_cfg.val,
+         (unsigned long)priv->hal.bridge_dev->data_type_cfg.val,
+         (unsigned long)priv->hal.bridge_dev->int_st.val);
+  if (priv->isp != NULL)
+    {
+      syslog(LOG_INFO,
+             "CSI: ISP cntl=0x%08lx clk=0x%08lx frame=0x%08lx\n",
+             (unsigned long)priv->isp->cntl.val,
+             (unsigned long)priv->isp->clk_en.val,
+             (unsigned long)priv->isp->frame_cfg.val);
+    }
+
+  for (i = 0; i < 1000; i++)
+    {
+      if (priv->hal.host_dev->phy_rx.phy_rxclkactivehs != 0)
+        {
+          clock_hs_samples++;
+        }
+
+      if ((priv->hal.host_dev->phy_stopstate.val & 0x00010003) ==
+          0x00010003)
+        {
+          all_stop_samples++;
+        }
+
+      up_udelay(100);
+    }
+
+  syslog(LOG_INFO,
+         "CSI: 100ms PHY samples clock_hs=%lu all_stop=%lu/1000\n",
+         (unsigned long)clock_hs_samples,
+         (unsigned long)all_stop_samples);
+}
