+/****************************************************************************
+ * Name: esp_mipi_dsi_set_framebuffer_callback
+ *
+ * Description:
+ *   Register the interrupt-safe framebuffer selector used between completed
+ *   video frames.
+ *
+ ****************************************************************************/
+
+int esp_mipi_dsi_set_framebuffer_callback(
+      esp_mipi_dsi_framebuffer_callback_t callback, FAR void *arg)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv = &g_esp_mipi_dsi;
+  irqstate_t flags;
+
+  flags = spin_lock_irqsave(&priv->dmalock);
+  if (!priv->fb_bound)
+    {
+      spin_unlock_irqrestore(&priv->dmalock, flags);
+      return -EAGAIN;
+    }
+
+  priv->fb_callback = callback;
