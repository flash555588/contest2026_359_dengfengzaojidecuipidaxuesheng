diff --git a/old/tools/espressif/espressif_mkimage.cmake b/new/tools/espressif/espressif_mkimage.cmake
--- a/old/tools/espressif/espressif_mkimage.cmake
+++ b/new/tools/espressif/espressif_mkimage.cmake
@@ -87,7 +87,7 @@ endif()
 # Find required tools for the post build process
 # ##############################################################################
 
-find_program(ESPTOOL esptool esptool.py)
+find_program(ESPTOOL NAMES esptool esptool.py)
 find_program(IMGTOOL imgtool)
 find_program(PYTHON3 python3)
 
@@ -174,6 +174,10 @@ else()
   # Simple boot or legacy: Use esptool elf2image
   message(STATUS "Generate NuttX image (esptool elf2image)")
 
+  if(NOT ESPTOOL)
+    message(FATAL_ERROR "esptool or esptool.py not found in PATH")
+  endif()
+
   # Check if nuttx ELF exists
   if(NOT EXISTS "${BINARY_DIR}/nuttx")
     message(FATAL_ERROR "nuttx ELF not found in ${BINARY_DIR}")
