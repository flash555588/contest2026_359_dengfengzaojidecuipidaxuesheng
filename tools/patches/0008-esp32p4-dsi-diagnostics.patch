+static void esp_mipi_dsi_framebuffer_worker(FAR void *arg)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv =
+    (FAR struct esp_mipi_dsi_priv_s *)arg;
+  esp_mipi_dsi_framebuffer_callback_t callback;
+  FAR void *callback_arg;
+  FAR void *next_fb;
+  irqstate_t flags;
+  bool active;
+
+  flags = spin_lock_irqsave(&priv->dmalock);
+  callback = priv->fb_callback;
+  callback_arg = priv->fb_callback_arg;
+  active = priv->dma_enabled;
+  priv->pending_fb = NULL;
+  spin_unlock_irqrestore(&priv->dmalock, flags);
+
+  if (!active || callback == NULL)
+    {
+      return;
+    }
+
+  next_fb = callback(callback_arg);
+  if (next_fb != NULL)
+    {
+      flags = spin_lock_irqsave(&priv->dmalock);
+      if (priv->dma_enabled)
+        {
+          priv->pending_fb = next_fb;
+        }
+
+      spin_unlock_irqrestore(&priv->dmalock, flags);
+    }
+}
