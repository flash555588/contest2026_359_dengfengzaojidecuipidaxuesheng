+static int esp_mipi_dsi_diag_ioctl(FAR struct file *filep, int cmd,
+                                   unsigned long arg)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv;
+  FAR struct esp_mipi_dsi_stats_s *stats;
+  irqstate_t flags;
+
+  if (filep == NULL || filep->f_inode == NULL)
+    {
+      return -EINVAL;
+    }
+
+  priv = filep->f_inode->i_private;
+  if (priv == NULL || !priv->initialized)
+    {
+      return -EAGAIN;
+    }
+
+  switch (cmd)
+    {
+      case ESP_MIPI_DSIIOC_GET_STATS:
+        stats = (FAR struct esp_mipi_dsi_stats_s *)(uintptr_t)arg;
+        if (stats == NULL)
+          {
+            return -EINVAL;
+          }
+
+        flags = spin_lock_irqsave(&priv->dmalock);
+        stats->frames = priv->frames;
+        stats->underruns = priv->underruns;
+        stats->worker_queue_errors = priv->worker_queue_errors;
+        spin_unlock_irqrestore(&priv->dmalock, flags);
+        stats->sampled_at_ticks = (uint64_t)clock_systime_ticks();
+        return OK;
+
+      case ESP_MIPI_DSIIOC_RESET_STATS:
+        flags = spin_lock_irqsave(&priv->dmalock);
+        priv->frames = 0;
+        priv->underruns = 0;
+        priv->worker_queue_errors = 0;
+        spin_unlock_irqrestore(&priv->dmalock, flags);
+        return OK;
+
+      default:
+        return -ENOTTY;
+    }
+}
+#endif
