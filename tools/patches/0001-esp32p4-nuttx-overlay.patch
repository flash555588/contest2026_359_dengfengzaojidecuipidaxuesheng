-  err = esp_cache_msync(addr, len,
-                        ESP_CACHE_MSYNC_FLAG_DIR_C2M |
-                        ESP_CACHE_MSYNC_FLAG_UNALIGNED);
-  return (err == ESP_OK) ? OK : -EIO;
+  /* esp_cache_msync() disables interrupts while writing cache lines back.
+   * A full RGB565 frame is large enough to starve the display and touch
+   * interrupt paths on pre-v3 ESP32-P4 silicon.  Keep each critical section
+   * bounded while preserving the same cache-to-memory operation.
+   */
+
+  current = addr;
+  remaining = len;
+  while (remaining > 0)
+    {
+      size_t chunk = remaining > 0x20000 ? 0x20000 : remaining;
+
+      err = esp_cache_msync(current, chunk,
+                            ESP_CACHE_MSYNC_FLAG_DIR_C2M |
+                            ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+      if (err != ESP_OK)
