+
 int esp_mipi_dsi_flush_framebuffer(FAR void *addr, size_t len)
 {
+  FAR uint8_t *current;
+  size_t remaining;
   esp_err_t err;
 
   if (addr == NULL || len == 0)
@@ -1592,10 +1663,31 @@ int esp_mipi_dsi_flush_framebuffer(FAR void *addr, size_t len)
