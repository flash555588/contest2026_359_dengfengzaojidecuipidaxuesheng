diff --git a/old/graphics/lvgl/apply-p4-patches.sh b/new/graphics/lvgl/apply-p4-patches.sh
new file mode 100644
--- /dev/null
+++ b/new/graphics/lvgl/apply-p4-patches.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+set -euo pipefail
+
+patch_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+source_dir="${1:?usage: apply-p4-patches.sh <lvgl-source-dir>}"
+patch_file="$patch_dir/0003-nuttx-fbdev-extra-pages.patch"
+
+if [[ -e "$source_dir/.git" ]]; then
+  actual="$(git -C "$source_dir" rev-parse HEAD)"
+  if [[ "$actual" != 59a6b61c9580b65089010c5273f2fcdd6c4d2aae ]]; then
+    echo "Unexpected LVGL revision: $actual" >&2
+    exit 1
+  fi
+fi
+
+if patch --batch --forward --dry-run -d "$source_dir" -p1 \
+    -i "$patch_file" >/dev/null 2>&1; then
+  patch --batch --forward -d "$source_dir" -p1 -i "$patch_file"
+elif patch --batch --reverse --dry-run -d "$source_dir" -p1 \
+    -i "$patch_file" >/dev/null 2>&1; then
+  echo "LVGL extra-pages patch: already applied"
+else
+  echo "LVGL extra-pages patch does not match this source tree" >&2
+  exit 1
+fi
diff --git a/old/graphics/lvgl/Makefile b/new/graphics/lvgl/Makefile
