+.PHONY: p4-lvgl-patches
+ifeq ($(CONFIG_ARCH_CHIP_ESP32P4),y)
+ifeq ($(wildcard $(LVGL_UNPACKNAME)/.git),)
+p4-lvgl-patches: $(LVGL_UNPACKNAME)
+endif
+p4-lvgl-patches:
+	$(Q) bash $(CURDIR)/apply-p4-patches.sh $(CURDIR)/$(LVGL_UNPACKNAME)
+
+context:: p4-lvgl-patches
+endif
+
 include $(APPDIR)/Application.mk
 
 ifeq ($(wildcard $(LVGL_UNPACKNAME)/.git),)
