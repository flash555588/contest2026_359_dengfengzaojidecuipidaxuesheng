diff --git a/drivers/input/Kconfig b/drivers/input/Kconfig
index 6cdf9051..66513303 100644
--- a/drivers/input/Kconfig
+++ b/drivers/input/Kconfig
@@ -624,6 +624,12 @@ config INPUT_GT9XX
 
 if INPUT_GT9XX
 
+config INPUT_GT9XX_POLL
+	int "Poll interval in ms (0 = interrupt driven)"
+	default 0
+	---help---
+		For panels without a wired INT line: periodically wake readers.
+
 config INPUT_GT9XX_NPOLLWAITERS
 	int "Number of waiters to poll"
 	default 1
diff --git a/drivers/input/gt9xx.c b/drivers/input/gt9xx.c
index 162dde09..4f374162 100644
--- a/drivers/input/gt9xx.c
+++ b/drivers/input/gt9xx.c
@@ -99,6 +99,10 @@ struct gt9xx_dev_s
   /* Poll Waiters for device */
 
   FAR struct pollfd *fds[CONFIG_INPUT_GT9XX_NPOLLWAITERS];
+
+#ifdef CONFIG_INPUT_GT9XX_POLL
+  struct work_s poll_work;   /* polling-mode reschedule */
+#endif
 };
 
 /****************************************************************************
@@ -841,6 +845,23 @@ out:
   return ret;
 }
 
+#ifdef CONFIG_INPUT_GT9XX_POLL
+static void gt9xx_poll_worker(FAR void *arg)
+{
+  FAR struct gt9xx_dev_s *priv = (FAR struct gt9xx_dev_s *)arg;
+  irqstate_t flags;
+
+  flags = enter_critical_section();
+  priv->int_pending = true;
+  leave_critical_section(flags);
+
+  poll_notify(priv->fds, CONFIG_INPUT_GT9XX_NPOLLWAITERS, POLLIN);
+
+  work_queue(HPWORK, &priv->poll_work, gt9xx_poll_worker, arg,
+             MSEC2TICK(CONFIG_INPUT_GT9XX_POLL));
+}
+#endif
+
 /****************************************************************************
  * Name: gt9xx_isr_handler
  *
@@ -953,5 +974,14 @@ int gt9xx_register(FAR const char *devpath,
   priv->board->irq_enable(priv->board, false);
 
   iinfo("GT9XX Touch Panel registered\n");
+
+#ifdef CONFIG_INPUT_GT9XX_POLL
+  if (CONFIG_INPUT_GT9XX_POLL > 0)
+    {
+      work_queue(HPWORK, &priv->poll_work, gt9xx_poll_worker,
+                 priv, MSEC2TICK(CONFIG_INPUT_GT9XX_POLL));
+    }
+#endif
+
   return OK;
 }
