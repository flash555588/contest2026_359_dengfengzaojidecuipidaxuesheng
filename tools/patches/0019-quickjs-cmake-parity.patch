diff --git a/old/interpreters/quickjs/CMakeLists.txt b/new/interpreters/quickjs/CMakeLists.txt
--- a/old/interpreters/quickjs/CMakeLists.txt
+++ b/new/interpreters/quickjs/CMakeLists.txt
@@ -29,11 +29,15 @@ if(CONFIG_INTERPRETERS_QUICKJS)
     FetchContent_Declare(
       quickjs_fetch
       URL ${QUICKJS_URL_BASE}/6e2e68fd0896957f92eb6c242a2e048c1ef3cae0.zip
+          URL_HASH
+          SHA256=d4542882686eefa8c0c80493dfb30d858588c0553ffe17a058189132607ff24e
           SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/quickjs BINARY_DIR
           ${NUTTX_BINARY_DIR}/apps/interpreters/quickjs/quickjs
       PATCH_COMMAND
