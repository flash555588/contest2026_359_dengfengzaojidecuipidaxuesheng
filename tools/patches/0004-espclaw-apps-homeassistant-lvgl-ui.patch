+static bool ha_component_valid(const char *text, bool dot)
+{
+  size_t i;
+
+  if (text == NULL || text[0] == '\0')
+    {
+      return false;
+    }
+
+  for (i = 0; text[i] != '\0'; i++)
+    {
+      if (!isalnum((unsigned char)text[i]) && text[i] != '_' &&
+          text[i] != '-' && (!dot || text[i] != '.'))
+        {
+          return false;
+        }
+    }
+
+  return i < 96;
+}
