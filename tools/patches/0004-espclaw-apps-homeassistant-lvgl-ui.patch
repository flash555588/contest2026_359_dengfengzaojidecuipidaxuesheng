+static int ha_send_all(int fd, const char *data, size_t length)
+{
+  ssize_t sent;
+
+  while (length > 0)
+    {
+      sent = send(fd, data, length, 0);
+      if (sent <= 0)
+        {
+          return -errno;
+        }
+
+      data += sent;
+      length -= sent;
+    }
+
+  return OK;
+}
