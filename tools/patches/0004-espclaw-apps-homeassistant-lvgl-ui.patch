+  if (JS_IsObject(argv[0]))
+    {
+      *holder = JS_GetPropertyStr(context, argv[0], "message");
+      return JS_ToCString(context, *holder);
+    }
+
+  *holder = JS_UNDEFINED;
+  return JS_ToCString(context, argv[0]);
+}
