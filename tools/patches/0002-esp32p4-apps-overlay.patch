+static bool qpk_path_component_valid(const char *text)
+{
+  const char *cursor;
+
+  if (text == NULL || text[0] == '\0' || text[0] == '/' ||
+      text[0] == '\\')
+    {
+      return false;
+    }
+
+  for (cursor = text; *cursor != '\0'; cursor++)
+    {
+      if (*cursor == ':' || *cursor == '\\' || *cursor == '/' ||
+          (*cursor == '.' && cursor[1] == '.'))
+        {
+          return false;
+        }
+    }
+
+  return true;
+}
