@@ -0,0 +1,17 @@
+--- a/src/libs/tiny_ttf/stb_truetype_htcw.h
++++ b/src/libs/tiny_ttf/stb_truetype_htcw.h
+@@ -2516,11 +2516,14 @@ static int stbtt__GetGlyphShapeT2(const stbtt_fontinfo * info, int glyph_index,
+     stbtt__csctx output_ctx = STBTT__CSCTX_INIT(0);
+     if(stbtt__run_charstring(info, glyph_index, &count_ctx)) {
+         *pvertices = (stbtt_vertex *)STBTT_malloc(count_ctx.num_vertices * sizeof(stbtt_vertex), info->userdata);
++        if(*pvertices == NULL)
++            return 0;
+         output_ctx.pvertices = *pvertices;
+         if(stbtt__run_charstring(info, glyph_index, &output_ctx)) {
+             STBTT_assert(output_ctx.num_vertices == count_ctx.num_vertices);
+             return output_ctx.num_vertices;
+         }
++        STBTT_free(*pvertices, info->userdata);
+     }
+     *pvertices = NULL;
+     return 0;
