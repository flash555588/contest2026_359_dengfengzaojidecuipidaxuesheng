+diff --git a/src/drivers/nuttx/lv_nuttx_fbdev.c b/src/drivers/nuttx/lv_nuttx_fbdev.c
+index 5ff500e..8c5fe09 100644
+--- a/src/drivers/nuttx/lv_nuttx_fbdev.c
