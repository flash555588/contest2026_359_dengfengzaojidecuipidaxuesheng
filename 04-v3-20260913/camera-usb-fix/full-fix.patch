+size_t usb_osal_enter_critical_section(void)
+{
+    irqstate_t flags;
+
+    flags = enter_critical_section();
+
+    return (size_t)flags;
+}
+
+void usb_osal_leave_critical_section(size_t flag)
+{
+    leave_critical_section(flag);
+}
