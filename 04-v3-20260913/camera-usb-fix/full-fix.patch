+          bool named = device.name[0] != 0;
+          bool previous_named = previous->name[0] != 0;
+          if (!(named && !previous_named) &&
+              !(named == previous_named && device.rssi > previous->rssi)) break;
+          g_state.devices[j] = *previous;
+          j--;
+        }
+      g_state.devices[j] = device;
+    }
 }
 
