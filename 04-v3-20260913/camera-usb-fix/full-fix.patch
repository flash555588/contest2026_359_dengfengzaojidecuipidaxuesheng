+extern uint32_t SystemCoreClock;
+
+void usbd_dwc2_delay_ms(uint8_t ms)
+{
+    uint32_t count = SystemCoreClock / 1000 * ms;
+    while (count--) {
+        __asm volatile("nop");
+    }
+}
+
+uint32_t usbd_dwc2_get_system_clock(void)
+{
+    return SystemCoreClock;
+}
