"  ui.setText(hint, pending && t.approval.can_approve === false ? '\u53c2\u6570\u5df2\u622a\u65ad\uff0c\u672c\u6b21\u53ea\u80fd\u62d2\u7edd\uff1b\u8bf7\u62c6\u5206\u64cd\u4f5c\u540e\u91cd\u8bd5' : t && t.state === 'waiting' ? '\u6838\u5bf9\u5b8c\u6574\u53c2\u6570\uff1b\u4ec5\u5141\u8bb8\u8fd9\u4e00\u6b21\u64cd\u4f5c' : '\u7535\u8111\u7ee7\u7eed\u8fd0\u884c\u4efb\u52a1\uff0c\u9000\u51fa\u6b64\u9875\u9762\u4e0d\u4f1a\u505c\u6b62');\n"
"}\n"
"function request(action,data,done,target) {return controller.send(action,data,done,target);}\n"
"function receive(data) {\n"
"  snapshot.storage_error=!!data.storage_error;\n"
"  if (data.clis) {snapshot.clis = data.clis; if (!data.clis.some(c => c.id === cfg.cli) && data.clis.length) cfg.cli = data.clis[0].id;}\n"
"  if (data.projects) snapshot.projects = data.projects;\n"
"  if (data.tasks) snapshot.tasks = data.tasks;\n"
"  if ('task' in data) {\n"
"    const previous = snapshot.task && snapshot.task.id;\n"
"    const approval = snapshot.task && snapshot.task.approval && snapshot.task.approval.id;\n"
"    snapshot.task = data.task;\n"
"    if(!data.task && cfg.selected){cfg.selected='';save();}\n"
"    if (data.task) {\n"
"      cfg.selected = data.task.id;\n"
"      if (previous !== data.task.id) {page = 0; view = 'text'; follow=true; save();}\n"
"      if (data.task.approval && data.task.approval.id !== approval) {view = 'approval';follow=false; page = 0;}\n"
"    }\n"
"  }\n"
"  if (!cfg.project && snapshot.projects.length) {cfg.project = snapshot.projects[0]; save();}\n"
"}\n"
"function refresh() {\n"
"  if (controller.pending) controller.reconcile(receive);\n"
"  else request('status',{id:cfg.selected},receive);\n"
"}\n"
"function sendKey(key) {\n"
"  const t=snapshot.task;\n"
"  if(t && t.interactive) {view='screen';follow=true;request('input',{id:t.id,key,request_id:controller.nextId()},receive);}\n"
"}\n"
"function chooseCli() {\n"
"  if (!snapshot.clis.length) return;\n"
"  const index = snapshot.clis.findIndex(c => c.id === cfg.cli);\n"
"  cfg.cli = snapshot.clis[(index + 1) % snapshot.clis.length].id; save(); render();\n"
"}\n"
"function inputTask(continuing) {\n"
"  const task = snapshot.task, project = continuing && task ? task.project : cfg.project;\n"
"  if (!project) {toast('\u8bf7\u5148\u9009\u62e9\u9879\u76ee'); return;}\n"
"  prompt.input({title: continuing ? '\u7ee7\u7eed\u8fd9\u4e2a\u4efb\u52a1' : '\u7ed9 ' + cfg.cli + ' \u7684\u4efb\u52a1', placeholder: '\u4f8b\u5982\uff1a\u67e5\u627e\u5e76\u4fee\u590d\u7f16\u8bd1\u9519\u8bef', value: cfg.draft || '', maxLength: 700}, value => {\n"
"    if (!value.trim()) return;\n"
"    if (continuing && task && active(task) && task.input) {\n"
"      cfg.draft=value;save();\n"
"      request('input',{id:task.id,text:value,request_id:controller.nextId()},receive);return;\n"
"    }\n"
"    const payload = {cli: continuing && task ? (task.cli || 'claude') : cfg.cli, project, prompt: value.trim(), request_id: controller.nextId()};\n"
"    if (continuing) payload.continue_id = task.id;\n"
"    cfg.draft = value.trim(); save();\n"
"    request('submit',payload,data => {receive(data);view='text';page=0;});\n"
"  });\n"
"}\n"
"function stop() { const t = snapshot.task; if (t && active(t)) request('stop', {id: t.id}, receive); }\n"
"function decide(allow) {\n"
"  const t = snapshot.task;\n"
"  if (t && t.approval) request('approve', {approval_id: t.approval.id, allow}, () => {toast(allow ? '\u5df2\u5141\u8bb8\u672c\u6b21\u64cd\u4f5c' : '\u5df2\u62d2\u7edd'); controller.nextPoll = 0;});\n"
"}\n"
"function chooseRow(index) {\n"
"  const value = items()[listPage * ROWS + index]; if (!value) return;\n"
"  if (projectsView) {cfg.project = value; projectsView = false; listPage = 0; save(); render();}\n"
"  else {cfg.selected = value.id; request('status', {id: value.id}, receive);}\n"
"}\n"
"function addProject() {\n"
"  prompt.input({title: '\u7535\u8111\u4e0a\u7684\u9879\u76ee\u8def\u5f84', value: cfg.project, maxLength: 240}, path => {\n"
"    request('project', {path}, data => {receive(data); cfg.project = data.selected_project; save(); projectsView = false;});\n"
"  });\n"
"}\n"
"function configure() {\n"
"  if(controller.pending && !controller.authRequired){toast('\u8bf7\u5148\u6838\u5bf9\u4e0a\u4e00\u6b21\u64cd\u4f5c\u518d\u66f4\u6362\u7535\u8111');return;}\n"
"  prompt.input({title: '\u7535\u8111\u6865\u63a5\u5730\u5740', value: cfg.url || 'http://192.168.31.95:8787', maxLength: 80}, url => {\n"
"    if (!CliController.validUrl(url)) {toast('\u8bf7\u8f93\u5165\u79c1\u7f51 IPv4 \u5730\u5740\u548c\u7aef\u53e3');return;}\n"
"    if(controller.pending && url!==controller.pending.url){toast('\u8bf7\u5148\u91cd\u65b0\u914d\u5bf9\u539f\u7535\u8111\u5e76\u6838\u5bf9\u64cd\u4f5c');return;}\n"
"    prompt.input({title: '\u7535\u8111\u914d\u5bf9\u7801', placeholder: '\u6865\u63a5\u670d\u52a1\u7684\u516d\u4f4d\u914d\u5bf9\u7801', maxLength: 6}, code => {\n"
"      if (!/^\\d{6}$/.test(code)) {toast('\u8bf7\u8f93\u5165\u516d\u4f4d\u6570\u5b57'); return;}\n"
"      request('pair', {code}, data => {cfg.url = url; cfg.token = data.token; if(!controller.pending)cfg.selected = ''; snapshot={projects:[],tasks:[],clis:[],task:null}; controller.connected=true;save(); controller.nextPoll = 0;}, url);\n"
"    });\n"
"  });\n"
"}\n"
"function tick() {controller.tick(receive);if(paintDeferred&&(!ui.isVisible||ui.isVisible()))render();}\n"
"controller.changed=render;\n"
"save();render();\n"
"setInterval(tick,250);\n"
;
