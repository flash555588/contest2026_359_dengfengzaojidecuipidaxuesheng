Cast through css_fixed so union casts are valid when int32_t is long
(riscv32-esp-elf/NuttX). Behaviour on other targets is unchanged.
Apply, then run: python3 src/select/select_generator.py

diff --git a/src/select/properties/helpers.c b/src/select/properties/helpers.c
index 0739c35..2347dc9 100644
--- a/src/select/properties/helpers.c
+++ b/src/select/properties/helpers.c
@@ -232,7 +232,7 @@ css_error css__cascade_length_auto_calc(uint32_t opv, css_style *style,
 				css_unit))
 {
 	uint16_t value = CSS_BOTTOM_INHERIT;
-	css_fixed_or_calc length = (css_fixed_or_calc)0;
+	css_fixed_or_calc length = (css_fixed_or_calc)(css_fixed)0;
 	uint32_t unit = CSS_UNIT_PX;
 	uint32_t snum = 0;
 
