[
  {
    "name": "scan_again",
    "command": "desktop ui ble-scan",
    "expect": [
      "ready"
    ]
  },
  {
    "name": "wait_active",
    "command": "sleep 2"
  },
  {
    "name": "active_scan",
    "command": "desktop ui audit",
    "expect": [
      "扫描中"
    ]
  },
  {
    "name": "network_during_scan",
    "command": "ifconfig",
    "expect": [
      "eth0.*(UP|RUNNING)",
      "bnep0.*RUNNING"
    ]
  },
  {
    "name": "storage_during_scan",
    "command": "desktop storage-test",
    "timeout": 30,
    "expect": [
      "storage selftest PASS"
    ]
  },
  {
    "name": "close_scan_page",
    "command": "desktop ui home",
    "expect": [
      "ready"
    ]
  },
  {
    "name": "cancel_wait",
    "command": "sleep 1"
  },
  {
    "name": "reopen_page",
    "command": "desktop ui bluetooth",
    "expect": [
      "ready"
    ]
  },
  {
    "name": "cancelled_state",
    "command": "desktop ui audit",
    "expect": [
      "就绪"
    ]
  },
  {
    "name": "scan_after_cancel",
    "command": "desktop ui ble-scan",
    "expect": [
      "ready"
    ]
  },
  {
    "name": "deadline_wait",
    "command": "sleep 11",
    "timeout": 15
  },
  {
    "name": "repeat_scan_finished",
    "command": "desktop ui audit",
    "expect": [
      "就绪",
      "[1-9][0-9]* 个设备"
    ]
  },
  {
    "name": "network_after_repeat",
    "command": "ifconfig",
    "expect": [
      "eth0.*(UP|RUNNING)",
      "bnep0.*RUNNING"
    ]
  },
  {
    "name": "free_after_repeat",
    "command": "free"
  }
]
