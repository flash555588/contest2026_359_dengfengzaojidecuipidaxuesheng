config SYSTEM_C6BLE_V3_EXPERIMENTAL
	bool "Experimental v3 C6 BLE HCI transport"
	default n
	depends on ARCH_CHIP_ESP32P4 && !ESP32P4_SELECTS_REV_LESS_V3
	depends on SYSTEM_C6PROBE=y && NET_BLUETOOTH && !DISABLE_PTHREAD
	depends on !WIRELESS_BLUETOOTH_HOST
	---help---
		Requires the matching HCI ownership patch. Register with c6ble register.
		Prepare Hosted before opening HCI; do not reset it while HCI is open.
		Registers raw HCI networking for the Apache NimBLE socket transport.
		This transport alone does not provide a BLE host or GATT services.
