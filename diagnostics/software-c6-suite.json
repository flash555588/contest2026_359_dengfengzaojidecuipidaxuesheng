  {"name":"c6_after_init","command":"c6probe stat"},
  {"name":"c6_rpc","command":"c6probe rpc","timeout":25,"expect":["c6probe: STA MAC"]},
  {"name":"c6_rpc_exit","command":"echo $?","expect":["^0$"]},
  {"name":"tasks_after_c6","command":"ps"},
  {"name":"heap_after_c6","command":"free"}
