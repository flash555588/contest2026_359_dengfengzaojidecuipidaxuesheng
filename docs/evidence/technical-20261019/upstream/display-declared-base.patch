+/****************************************************************************
+ * Name: esp_mipi_dsi_get_diagnostics
+ *
+ * Description:
+ *   Snapshot the video DMA and bridge status for board bring-up.
+ ****************************************************************************/
+
+int esp_mipi_dsi_get_diagnostics(FAR uint32_t *dma_frames,
+                                 FAR uint32_t *dma_status,
+                                 FAR uint32_t *bridge_status,
+                                 FAR uint32_t *lane_mbps_x100,
+                                 FAR uint32_t *dpi_expect_mhz_x100,
+                                 FAR uint32_t *dpi_real_mhz_x100,
+                                 FAR uint32_t *host_int_st0,
+                                 FAR uint32_t *host_int_st1,
+                                 FAR uint32_t *host_vid_pkt_status,
+                                 FAR uint32_t *host_phy_status,
+                                 FAR uint32_t *host_color_coding)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv = &g_esp_mipi_dsi;
+
+  if (dma_frames == NULL || dma_status == NULL || bridge_status == NULL ||
+      lane_mbps_x100 == NULL || dpi_expect_mhz_x100 == NULL ||
+      dpi_real_mhz_x100 == NULL || host_int_st0 == NULL ||
+      host_int_st1 == NULL || host_vid_pkt_status == NULL ||
+      host_phy_status == NULL || host_color_coding == NULL ||
+      !priv->initialized)
+    {
+      return -EINVAL;
+    }
+
+  *dma_frames = priv->dma_tfr_count;
+  *dma_status = priv->dw_hal.dev != NULL ? priv->dma_last_status : 0;
+  *bridge_status = mipi_dsi_brg_ll_get_interrupt_status(priv->hal.bridge);
+  *lane_mbps_x100 = (uint32_t)lroundf(priv->hal.lane_bit_rate_mbps * 100.0f);
+  *dpi_expect_mhz_x100 =
+    (uint32_t)lroundf(priv->hal.expect_dpi_clock_freq_mhz * 100.0f);
+  *dpi_real_mhz_x100 =
+    (uint32_t)lroundf(priv->hal.real_dpi_clock_freq_mhz * 100.0f);
+  *host_int_st0 = priv->hal.host->int_st0.val;
+  *host_int_st1 = priv->hal.host->int_st1.val;
+  *host_vid_pkt_status = priv->hal.host->vid_pkt_status.val;
+  *host_phy_status = priv->hal.host->phy_status.val;
+  *host_color_coding = priv->hal.host->dpi_color_coding_act.val;
+  return OK;
+}
