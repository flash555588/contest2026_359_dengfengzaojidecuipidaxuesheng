+/****************************************************************************
+ * Name: esp_mipi_dsi_cache_writeback
+ *
+ * Description:
+ *   Write a dirty framebuffer range back in bounded chunks.  Cache writeback
+ *   masks interrupts, so keep each operation short enough for continuous I2S
+ *   playback while LVGL updates a moving object.
+ ****************************************************************************/
+
+static int esp_mipi_dsi_cache_writeback(FAR void *addr, size_t len)
+{
+  FAR uint8_t *cursor = (FAR uint8_t *)addr;
+  esp_err_t err;
+  size_t total = len;
+  size_t chunks = 0;
+  size_t chunk;
+
+  while (len > 0)
+    {
+      chunk = len > ESP_MIPI_DSI_CACHE_CHUNK ?
+              ESP_MIPI_DSI_CACHE_CHUNK : len;
+      err = esp_cache_msync(cursor, chunk,
+                            ESP_CACHE_MSYNC_FLAG_DIR_C2M |
+                            ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+      if (err != ESP_OK)
+        {
+          return -EIO;
+        }
+
+      cursor += chunk;
+      len -= chunk;
+      chunks++;
+    }
+
+  vinfo("esp_mipi_dsi: cache writeback %zu bytes in %zu chunks\n",
+        total, chunks);
   return OK;
 }
 
