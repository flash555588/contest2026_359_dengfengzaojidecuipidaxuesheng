+/****************************************************************************
+ * Name: esp_mipi_dsi_set_test_pattern
+ ****************************************************************************/
+
+int esp_mipi_dsi_set_test_pattern(bool enable)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv = &g_esp_mipi_dsi;
+  int ret;
+
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (!priv->initialized || !priv->dpi_configured || priv->video_running)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -EAGAIN;
+    }
+
+  mipi_dsi_host_ll_dpi_set_pattern_type(
+    priv->hal.host,
+    enable ? MIPI_DSI_PATTERN_BAR_VERTICAL : MIPI_DSI_PATTERN_NONE);
+  priv->test_pattern_enabled = enable;
+  nxmutex_unlock(&priv->lock);
+  return OK;
+}
