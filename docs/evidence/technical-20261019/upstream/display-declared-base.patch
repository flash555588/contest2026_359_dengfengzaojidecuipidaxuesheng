+/****************************************************************************
+ * Name: esp_mipi_dsi_get_timing_diagnostics
+ *
+ * Description:
+ *   Read back the bridge timing and the programmed DSI host registers.
+ ****************************************************************************/
+
+int esp_mipi_dsi_get_timing_diagnostics(
+      FAR struct esp_mipi_dsi_timing_diagnostics_s *diag)
+{
+  FAR struct esp_mipi_dsi_priv_s *priv = &g_esp_mipi_dsi;
+  FAR dsi_brg_dev_t *bridge;
+  FAR dsi_host_dev_t *host;
+
+  if (diag == NULL || !priv->initialized)
+    {
+      return -EINVAL;
+    }
+
+  bridge = priv->hal.bridge;
+  host = priv->hal.host;
+
+  diag->bridge_raw_words = bridge->raw_num_cfg.raw_num_total;
+  diag->bridge_fifo_status = bridge->fifo_flow_status.val;
+  diag->bridge_pixel_type = bridge->pixel_type.val;
+  diag->bridge_htotal = bridge->dpi_h_cfg0.htotal;
+  diag->bridge_hactive = bridge->dpi_h_cfg0.hdisp;
+  diag->bridge_hsync = bridge->dpi_h_cfg1.hsync;
+  diag->bridge_hback_porch = bridge->dpi_h_cfg1.hbank;
+  diag->bridge_vtotal = bridge->dpi_v_cfg0.vtotal;
+  diag->bridge_vactive = bridge->dpi_v_cfg0.vdisp;
+  diag->bridge_vsync = bridge->dpi_v_cfg1.vsync;
+  diag->bridge_vback_porch = bridge->dpi_v_cfg1.vbank;
+
+  diag->host_packet_pixels = host->vid_pkt_size.vid_pkt_size;
+  diag->host_hsync_time = host->vid_hsa_time.vid_hsa_time;
+  diag->host_hback_porch_time = host->vid_hbp_time.vid_hbp_time;
+  diag->host_hline_time = host->vid_hline_time.vid_hline_time;
+  diag->host_vsync_lines = host->vid_vsa_lines.vsa_lines;
+  diag->host_vback_porch_lines = host->vid_vbp_lines.vbp_lines;
+  diag->host_vfront_porch_lines = host->vid_vfp_lines.vfp_lines;
+  diag->host_vactive_lines = host->vid_vactive_lines.v_active_lines;
+  return OK;
+}
