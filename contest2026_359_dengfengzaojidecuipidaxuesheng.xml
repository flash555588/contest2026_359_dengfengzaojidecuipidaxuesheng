<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_359_dengfengzaojidecuipidaxuesheng"
           name="contest2026_359_dengfengzaojidecuipidaxuesheng"
           remote="esp32p4-team"
           revision="codex/espclaw-final">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_359_hello_app"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_359_hello_quickapp"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_359_board"/>
    <!--
      ESP32-P4 L0 overlay. These destinations do not exist in official
      open-vela nuttx on dev-ai-contest-2026, so repo <linkfile> can create
      them. common/espressif and tools/espressif already exist upstream;
      tools/apply_esp32p4_overlay.py copies those in place after sync.
    -->
    <linkfile src="board/esp32p4-function-ev-board" dest="vendor/espressif/boards/esp32p4/esp32p4-function-ev-board"/>
    <linkfile src="board/esp32p4-common" dest="nuttx/boards/risc-v/esp32p4/common"/>
    <linkfile src="chip/esp32p4/src" dest="nuttx/arch/risc-v/src/esp32p4"/>
    <linkfile src="chip/esp32p4/include" dest="nuttx/arch/risc-v/include/esp32p4"/>
  </project>
</manifest>
